{
  "version": 1,
  "name": "e-Fatura USD",
  "documentType": "EFATURA",
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margins": {
      "top": 10,
      "right": 10,
      "bottom": 10,
      "left": 10
    }
  },
  "theme": {
    "fontFamily": "Arial",
    "fontSize": 9,
    "primaryColor": "#1f3a5f",
    "textColor": "#000000",
    "borderStyle": "solid"
  },
  "sections": [
    {
      "id": "header",
      "kind": "header",
      "columns": 3,
      "blocks": [
        {
          "id": "logo",
          "type": "logo",
          "column": 1,
          "dataUri": "data:image/png;base64,iVBORw0KGgo=",
          "widthMm": 30
        },
        {
          "id": "watermark",
          "type": "field",
          "column": 2,
          "field": "derived.watermark",
          "style": {
            "align": "center",
            "bold": true,
            "fontSize": 14
          }
        },
        {
          "id": "doc-id",
          "type": "field",
          "column": 3,
          "field": "doc.id",
          "label": "Fatura No"
        },
        {
          "id": "doc-date",
          "type": "field",
          "column": 3,
          "field": "doc.issueDate",
          "label": "Fatura Tarihi",
          "format": "date"
        },
        {
          "id": "doc-ettn",
          "type": "field",
          "column": 3,
          "field": "doc.uuid",
          "label": "ETTN"
        },
        {
          "id": "doc-cur",
          "type": "field",
          "column": 3,
          "field": "doc.currency",
          "label": "Para Birimi"
        },
        {
          "id": "doc-rate",
          "type": "field",
          "column": 3,
          "field": "doc.exchangeRate",
          "label": "Döviz Kuru",
          "format": "number"
        }
      ]
    },
    {
      "id": "parties",
      "kind": "parties",
      "columns": 2,
      "blocks": [
        {
          "id": "s-name",
          "type": "field",
          "column": 1,
          "field": "supplier.name",
          "style": {
            "bold": true
          }
        },
        {
          "id": "s-tax",
          "type": "field",
          "column": 1,
          "field": "supplier.taxId",
          "label": "VKN/TCKN"
        },
        {
          "id": "c-name",
          "type": "field",
          "column": 2,
          "field": "customer.name",
          "style": {
            "bold": true
          }
        },
        {
          "id": "c-tax",
          "type": "field",
          "column": 2,
          "field": "customer.taxId",
          "label": "VKN/TCKN"
        }
      ]
    },
    {
      "id": "lines",
      "kind": "lines",
      "blocks": [
        {
          "id": "line-table",
          "type": "lineTable",
          "columns": [
            {
              "field": "line.no",
              "label": "Sıra",
              "widthPct": 5
            },
            {
              "field": "line.name",
              "label": "Mal/Hizmet",
              "widthPct": 35
            },
            {
              "field": "line.quantity",
              "label": "Miktar",
              "widthPct": 10,
              "align": "right",
              "format": "number"
            },
            {
              "field": "line.unitPrice",
              "label": "Birim Fiyat",
              "widthPct": 15,
              "align": "right",
              "format": "money"
            },
            {
              "field": "line.kdvRate",
              "label": "KDV %",
              "widthPct": 10,
              "align": "right",
              "format": "percent"
            },
            {
              "field": "line.kdvAmount",
              "label": "KDV",
              "widthPct": 10,
              "align": "right",
              "format": "money"
            },
            {
              "field": "line.extension",
              "label": "Tutar",
              "widthPct": 15,
              "align": "right",
              "format": "money"
            }
          ]
        }
      ]
    },
    {
      "id": "totals",
      "kind": "totals",
      "blocks": [
        {
          "id": "totals",
          "type": "totals",
          "rows": [
            "lineExtension",
            "taxExclusive",
            "tax",
            "taxInclusive",
            "payable"
          ]
        },
        {
          "id": "payable-usd",
          "type": "field",
          "field": "totals.payable",
          "label": "Ödenecek (USD)",
          "format": "money"
        }
      ]
    }
  ]
}